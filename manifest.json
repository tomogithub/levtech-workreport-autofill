{
  "manifest_version": 3,
  "name": "LevTech Workreport Autofill",
  "version": "2.0.0",
  "description": "LevTech Platformの作業報告書に開始時間、終了時間、休憩時間、作業内容をまとめて入力します。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://platform.levtech.jp/*"
  ],
  "action": {
    "default_title": "勤怠自動入力",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://platform.levtech.jp/p/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
